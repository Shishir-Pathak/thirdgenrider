#############################################
# Production-ready .htaccess for cPanel/Apache
# - Forces HTTPS
# - Prevents directory listing and blocks sensitive files
# - Adds SPA fallback (serves index.html for client-side routes)
# - Enables gzip/deflate compression
# - Adds caching rules for static assets
# - Adds common security headers (HSTS only on HTTPS)
#############################################

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Force HTTPS ---
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- SPA fallback: if request is not a real file or directory, serve index.html ---
  # Adjust this if your app is served from a subfolder (e.g. /app/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

# --- Prevent directory listing ---
Options -Indexes

# --- Deny access to sensitive files ---
<FilesMatch "^(?:\.env|\.git|composer\.json|package\.json|package-lock\.json|yarn\.lock|README(?:\.md)?|webpack\.config\.js)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Common security headers
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "no-referrer-when-downgrade"
  Header set Permissions-Policy "geolocation=(), microphone=()"

  # CORS for fonts (if you host fonts separately)
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# HSTS: only set when on HTTPS (Apache 2.4+ for <If> expression)
<IfModule mod_headers.c>
  <If "%{HTTPS} == 'on'">
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  </If>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  <IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|svg)$ no-gzip dont-vary
  </IfModule>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  # Ensure proxies deliver compressed content correctly
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding
  </IfModule>
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 600 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/* "access plus 1 month"
  ExpiresByType font/* "access plus 1 month"
  ExpiresByType application/font-woff "access plus 1 month"
  ExpiresDefault "access plus 1 month"
</IfModule>

# Remove ETag (optional, helps with some caching setups)
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>

# --- Recommended: hide server tokens if possible ---
ServerSignature Off

# --- Fallback / custom error pages (optional) ---
ErrorDocument 404 /index.html
